# Porta interna do container (gunicorn)
PORT=8000

# Título do app (aparece no topo)
APP_TITLE=DocRH - Gerador de Documentos

# Diretórios (dentro do container)
TEMPLATES_DIR=/app/docx_templates
OUTPUT_DIR=/app/out

# Opcional: pasta de rede montada no host e mapeada no container
OUTPUT_NETWORK_DIR=/network/rh_docs

# Flask secret (troque em produção)
SECRET_KEY=troque-este-segredo
